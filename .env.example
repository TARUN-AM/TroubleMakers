# Vulnerability Watch Configuration
PORT=8000
HOST=127.0.0.1
DATABASE_PATH=vulnerability_watch.db

# GitHub API & Webhooks
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=demo_webhook_secret

# LLM (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Scheduler
SCAN_INTERVAL_MIN=60

# Demo & Testing
DRY_RUN=true
DEMO_INJECT_FAILURE=false
